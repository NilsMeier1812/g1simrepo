<mujoco model="g1_29dof playground">
  <!-- =====================================================================
       LAUFFAEHIGE Beispiel-Szene:  G1-Roboter  +  eigene Umgebung
       ---------------------------------------------------------------------
       Diese Datei liegt bewusst im g1-Roboterordner (wie scene.xml,
       scene_29dof.xml ...), weil MuJoCo die Roboter-Meshes ueber
       <compiler meshdir="meshes"> nur dann findet, wenn die Szene
       die den Roboter einbindet im selben Ordner liegt.

       In den Unitree-Sim einbinden:
         - simulate_python/config.py :  ROBOT_SCENE = "../unitree_robots/g1/scene_g1_playground.xml"
         - oder direkt ansehen:          ./scene_editor/launch.sh view-g1
       ---------------------------------------------------------------------
       EIGENE OBJEKTE HINZUFUEGEN
       - Primitive (box/sphere/cylinder/...) : einfach ein <geom> in <worldbody>.
       - Eigenes STL: 1 Zeile in <asset> (<mesh ...>) + 1 <geom type="mesh">.
         WICHTIG - Mesh-Pfad: hier gilt meshdir="meshes" (aus g1_29dof.xml),
         d.h. Pfade sind relativ zu unitree_robots/g1/meshes/ zu sehen.
         Eigene STLs liegen unter scene_editor/meshes/ -> Prefix
             ../../../scene_editor/meshes/DEINE_DATEI.stl
         (Beim Uebernehmen aus environment_starter.xml nur das Pfad-Prefix
          von ../meshes/ auf ../../../scene_editor/meshes/ aendern.)
       ===================================================================== -->

  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Eigene STLs (Pfad relativ zu meshdir=meshes, siehe Hinweis oben) -->
    <mesh name="sample_crate" file="../../../scene_editor/meshes/sample_crate.stl"/>
    <mesh name="sample_ramp"  file="../../../scene_editor/meshes/sample_ramp.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Primitive -->
    <geom name="box_demo"      type="box"      pos="1.0  0.6 0.15" size="0.15 0.15 0.15" rgba="0.85 0.45 0.20 1"/>
    <geom name="cylinder_demo" type="cylinder" pos="1.0 -0.6 0.25" size="0.15 0.25"      rgba="0.30 0.55 0.75 1"/>

    <!-- Eigene STLs platziert -->
    <geom name="crate_demo" type="mesh" mesh="sample_crate" pos="1.6  0.0 0.15" rgba="0.60 0.60 0.62 1"/>
    <geom name="ramp_demo"  type="mesh" mesh="sample_ramp"  pos="2.0 -0.3 0.0"  rgba="0.45 0.70 0.45 1"/>
  </worldbody>
</mujoco>
